diff --git a/public/sw.js b/public/sw.js
new file mode 100644
index 0000000..d16005f
--- /dev/null
+++ b/public/sw.js
@@ -0,0 +1,30 @@
+// Service worker mínimo: hace que la app se pueda instalar y que abra aunque se corte internet un momento.
+// Va siempre primero a la red (así una versión nueva se ve apenas se publica) y usa la copia guardada solo si no hay conexión.
+// Firestore y Firebase Auth son de otro dominio: no pasan por acá.
+const CACHE = 'jefe-de-planta-v1';
+
+self.addEventListener('install', () => self.skipWaiting());
+
+self.addEventListener('activate', (e) => {
+  e.waitUntil(
+    caches.keys()
+      .then((claves) => Promise.all(claves.filter((c) => c !== CACHE).map((c) => caches.delete(c))))
+      .then(() => self.clients.claim())
+  );
+});
+
+self.addEventListener('fetch', (e) => {
+  const pedido = e.request;
+  if (pedido.method !== 'GET' || new URL(pedido.url).origin !== self.location.origin) return;
+  e.respondWith(
+    fetch(pedido)
+      .then((respuesta) => {
+        if (respuesta.ok) {
+          const copia = respuesta.clone();
+          caches.open(CACHE).then((c) => c.put(pedido, copia));
+        }
+        return respuesta;
+      })
+      .catch(async () => (await caches.match(pedido)) ?? (pedido.mode === 'navigate' ? await caches.match('/') : undefined) ?? Response.error())
+  );
+});
diff --git a/src/components/BotonInstalar.jsx b/src/components/BotonInstalar.jsx
new file mode 100644
index 0000000..26fc8c6
--- /dev/null
+++ b/src/components/BotonInstalar.jsx
@@ -0,0 +1,49 @@
+import { useEffect, useState } from 'react';
+import { Download } from 'lucide-react';
+
+// El navegador avisa una sola vez que la app se puede instalar: se guarda acá para usarlo cuando se toque el botón
+let ofertaGuardada = null;
+const oyentes = new Set();
+if (typeof window !== 'undefined') {
+  window.addEventListener('beforeinstallprompt', (e) => {
+    e.preventDefault();
+    ofertaGuardada = e;
+    oyentes.forEach((f) => f());
+  });
+  window.addEventListener('appinstalled', () => {
+    ofertaGuardada = null;
+    oyentes.forEach((f) => f());
+  });
+}
+
+const yaInstalada = () => window.matchMedia?.('(display-mode: standalone)').matches || window.navigator.standalone === true;
+const esIPhone = () => /iphone|ipad|ipod/i.test(window.navigator.userAgent);
+
+// Botón "Instalar app" (Android y computadoras). En iPhone/iPad no existe ese botón: se explica el paso a mano.
+export default function BotonInstalar() {
+  const [, repintar] = useState(0);
+  useEffect(() => {
+    const f = () => repintar((n) => n + 1);
+    oyentes.add(f);
+    return () => oyentes.delete(f);
+  }, []);
+
+  if (yaInstalada()) return null;
+  if (ofertaGuardada) {
+    const instalar = async () => {
+      ofertaGuardada.prompt();
+      await ofertaGuardada.userChoice.catch(() => {});
+      ofertaGuardada = null;
+      repintar((n) => n + 1);
+    };
+    return (
+      <button type="button" onClick={instalar} className="mx-auto flex items-center gap-1.5 text-sm underline text-acero/70 hover:text-acero">
+        <Download className="size-4" aria-hidden="true" />Instalar la app en este dispositivo
+      </button>
+    );
+  }
+  if (esIPhone()) {
+    return <p className="text-center text-sm text-acero/70">Para instalarla: tocá Compartir y elegí “Agregar a inicio”.</p>;
+  }
+  return null;
+}

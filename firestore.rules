rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function docenteExiste() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/docentes/$(request.auth.uid));
    }

    // Docente de Ed. Física: su documento en /docentes tiene rol = 'edfisica'. Solo puede aprobar tareas ef_* (ver más abajo)
    function esDocenteEF() {
      return docenteExiste()
        && get(/databases/$(database)/documents/docentes/$(request.auth.uid)).data.get('rol', '') == 'edfisica';
    }

    // Superadmin: docente completo cuyo documento en /docentes tiene rol = 'superadmin'. Es el único que puede borrar jornadas (Volver a cero)
    function esSuperadmin() {
      return docenteExiste()
        && get(/databases/$(database)/documents/docentes/$(request.auth.uid)).data.get('rol', '') == 'superadmin';
    }

    // Docente completo: figura en /docentes (se crea a mano en la consola) y no tiene el rol restringido de Ed. Física
    function esDocente() {
      return docenteExiste() && !esDocenteEF();
    }

    // El cambio de un mapa (declaradas, aprobadas, devoluciones) solo toca claves de Ed. Física
    function soloTareasEF(campo) {
      return !(campo in request.resource.data.diff(resource.data).affectedKeys())
        || request.resource.data[campo].diff(resource.data.get(campo, {})).affectedKeys()
             .hasOnly(['ef_salida', 'ef_equipo', 'ef_agua', 'ef_materiales', 'ef_devolucion', 'ef_regreso']);
    }

    // Fecha de hoy en Argentina (UTC-3) como 'AAAA-MM-DD', calculada con la hora del servidor
    function fechaAR(t) {
      let a = t - duration.value(3, 'h');
      return string(a.year()) + '-' + (a.month() < 10 ? '0' : '') + string(a.month())
        + '-' + (a.day() < 10 ? '0' : '') + string(a.day());
    }

    // Los alumnos solo escriben jornadas de ayer, hoy o mañana (tolera un reloj desfasado). Así nadie puede
    // inventar fechas para llenar la base ni tocar jornadas viejas; el docente no tiene esta restricción.
    function fechaCercana(f) {
      return f in [
        fechaAR(request.time),
        fechaAR(request.time - duration.value(1, 'd')),
        fechaAR(request.time + duration.value(1, 'd'))
      ];
    }

    // Lo que puede escribir un alumno: solo tareas declaradas y su respuesta
    function datosAlumnoValidos() {
      let d = request.resource.data;
      return (!('declaradas' in d)
              || (d.declaradas is map
                  && d.declaradas.keys().hasOnly(['fichaje', 'ventilacion', 'insumos', 'asistencia', 'desafio', 'limpieza', 'apagado', 'luces', 'ef_salida', 'ef_equipo', 'ef_agua', 'ef_materiales', 'ef_devolucion', 'ef_regreso', 'x1', 'x2', 'x3', 'x4', 'x5'])
                  && d.declaradas.values().hasOnly([true, false])))
          && (!('respuesta' in d) || (d.respuesta is string && d.respuesta.size() <= 200))
          && (!('asistencia' in d)
              || (d.asistencia is map
                  && d.asistencia.keys().hasOnly(['presentes', 'tardes'])
                  && d.asistencia.presentes is int && d.asistencia.tardes is int
                  && d.asistencia.presentes >= 0 && d.asistencia.presentes <= 60
                  && d.asistencia.tardes >= 0 && d.asistencia.tardes <= d.asistencia.presentes));
    }

    // PIN por líder (opcional): si el docente cargó un PIN para un líder (documento pines/{id}), solo la sesión que lo escribió bien
    // puede crear o modificar las jornadas de ese líder. Si no hay PIN cargado, todo funciona como siempre.
    function pinRequerido(jefeId) {
      return exists(/databases/$(database)/documents/pines/$(string(jefeId)));
    }

    function pinDe(jefeId) {
      return get(/databases/$(database)/documents/pines/$(string(jefeId))).data.pin;
    }

    function conSesion(jefeId) {
      return !pinRequerido(jefeId)
        || (exists(/databases/$(database)/documents/sesiones/$(request.auth.uid))
            && get(/databases/$(database)/documents/sesiones/$(request.auth.uid)).data.jefeId == jefeId
            && get(/databases/$(database)/documents/sesiones/$(request.auth.uid)).data.pin == pinDe(jefeId)
            && fechaCercana(get(/databases/$(database)/documents/sesiones/$(request.auth.uid)).data.fecha));
    }

    match /docentes/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Desafío del día: lo escribe el docente; los alumnos solo lo leen
    match /desafios/{fecha} {
      allow read: if signedIn();
      allow write: if esDocente();
    }

    // Respuesta esperada / criterio de corrección: solo visible para docentes
    match /desafios_docente/{fecha} {
      allow read, write: if esDocente();
    }

    // Tareas extra del día: las escribe el docente
    match /tareas_extra/{fecha} {
      allow read: if signedIn();
      allow write: if esDocente();
    }

    // Premio de la semana: lo carga el docente (el id es el lunes de la semana)
    match /premios/{semana} {
      allow read: if signedIn();
      allow write: if esDocente();
    }

    // Días con novedades (sin clase / suplente del líder): los carga el docente, el id es la fecha AAAA-MM-DD
    match /dias/{fecha} {
      allow read: if signedIn();
      allow write: if esDocente();
    }

    // Configuración con fecha de vigencia: líderes de cada día (lideres) y días de la semana con Ed. Física (edfisica).
    // La lee cualquiera con sesión y la escribe solo el docente
    // Qué líderes tienen PIN (solo los números, nunca los PIN): lo lee cualquiera con sesión, lo escribe el docente
    match /config/pines {
      allow write: if esDocente()
        && request.resource.data.keys().hasOnly(['requeridos'])
        && request.resource.data.requeridos is list
        && request.resource.data.requeridos.size() <= 5;
    }

    match /config/{id} {
      allow read: if signedIn();
      allow write: if esDocente()
        && (id == 'lideres' || id == 'edfisica')
        && request.resource.data.keys().hasOnly(['versiones'])
        && request.resource.data.versiones is list
        && request.resource.data.versiones.size() <= 60;
    }

    // Bonos de puntos extra: solo el docente los crea o los quita; nunca se editan
    match /bonos/{id} {
      allow read: if signedIn();
      allow create: if esDocente()
        && request.resource.data.keys().hasOnly(['turnoId', 'puntos', 'motivo', 'fecha', 'creado'])
        && request.resource.data.keys().hasAll(['turnoId', 'puntos', 'motivo', 'fecha'])
        && request.resource.data.turnoId in ['e1', 'e2', 'e3', 'e4', 'e5']
        && request.resource.data.puntos is int
        && request.resource.data.puntos >= 1 && request.resource.data.puntos <= 100
        && request.resource.data.motivo is string && request.resource.data.motivo.size() <= 80
        && request.resource.data.fecha is string
        && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if esDocente();
    }

    // Sorteo de grupos de la semana (el id es el lunes de esa semana): lo ve cualquiera con sesión y lo hace el docente.
    // Al crearlo vale intentos = 1 y cada cambio de la misma semana suma exactamente 1: se ve cuántas veces se tocó.
    // `manuales` son los líderes cuyo grupo se definió a mano.
    match /grupos/{semana} {
      allow read: if signedIn();
      allow create: if esDocente()
        && semana.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['semana', 'creado', 'intentos', 'manuales', 'lideres', 'grupos'])
        && request.resource.data.semana == semana
        && request.resource.data.creado == request.time
        && request.resource.data.intentos == 1
        && request.resource.data.manuales is list
        && request.resource.data.lideres is map
        && request.resource.data.grupos is map;
      allow update: if esDocente()
        && request.resource.data.keys().hasOnly(['semana', 'creado', 'intentos', 'manuales', 'lideres', 'grupos'])
        && request.resource.data.semana == semana
        && request.resource.data.creado == request.time
        && request.resource.data.intentos == resource.data.intentos + 1
        && request.resource.data.manuales is list
        && request.resource.data.lideres is map
        && request.resource.data.grupos is map;
      allow delete: if esDocente();
    }

    // PIN de cada líder: solo lo ven y lo escriben los docentes (id = número de líder, 1 a 5; 4 dígitos)
    match /pines/{id} {
      allow read: if esDocente();
      allow create, update: if esDocente()
        && id.matches('^[1-5]$')
        && request.resource.data.keys().hasOnly(['pin'])
        && request.resource.data.pin is string
        && request.resource.data.pin.matches('^[0-9]{4}$');
      allow delete: if esDocente();
    }

    // Sesión del alumno: prueba que esa cuenta anónima conoce el PIN del líder que eligió. La crea el dueño de la cuenta.
    match /sesiones/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || docenteExiste());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['jefeId', 'pin', 'fecha'])
        && request.resource.data.jefeId is int
        && request.resource.data.jefeId >= 1 && request.resource.data.jefeId <= 5
        && request.resource.data.pin is string && request.resource.data.pin.size() <= 8
        && request.resource.data.fecha is string
        && fechaCercana(request.resource.data.fecha)
        && (!pinRequerido(request.resource.data.jefeId)
            || request.resource.data.pin == pinDe(request.resource.data.jefeId));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /turnos/{turnoId} {
      allow read: if signedIn();
      allow write: if esDocente();   // los alumnos nunca escriben puntos
      // Ed. Física: solo puede sumar exactamente PUNTOS_EDFISICA (10) al aprobar su checklist
      allow create: if esDocenteEF()
        && request.resource.data.keys().hasOnly(['puntos'])
        && request.resource.data.puntos == 10;
      allow update: if esDocenteEF()
        && request.resource.data.keys().hasOnly(['puntos'])
        && request.resource.data.puntos == resource.data.puntos + 10;
    }

    match /jornadas/{docId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fecha', 'jefeId', 'declaradas', 'respuesta', 'asistencia'])
        && request.resource.data.keys().hasAll(['fecha', 'jefeId'])
        && request.resource.data.fecha is string
        && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && fechaCercana(request.resource.data.fecha)
        && request.resource.data.jefeId is int
        && request.resource.data.jefeId >= 1 && request.resource.data.jefeId <= 5
        && conSesion(request.resource.data.jefeId)
        && docId == request.resource.data.fecha + '_' + string(request.resource.data.jefeId)
        && datosAlumnoValidos();

      allow update: if signedIn()
        && fechaCercana(resource.data.fecha)
        && conSesion(resource.data.jefeId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['declaradas', 'respuesta', 'asistencia'])
        && datosAlumnoValidos()
        // una vez aprobado el desafío, la respuesta ya no se puede cambiar
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['respuesta'])
            || resource.data.get('desafioAprobado', false) == false)
        // ni la asistencia, una vez aprobada
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['asistencia'])
            || resource.data.get('aprobadas', {}).get('asistencia', false) == false);

      allow create, update: if esDocente();
      allow delete: if esSuperadmin();

      // Ed. Física: aprueba o rechaza solo tareas ef_*, y solo puede activar el premio de Ed. Física
      allow update: if esDocenteEF()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['declaradas', 'aprobadas', 'devoluciones', 'premioEdFisica'])
        && soloTareasEF('declaradas')
        && soloTareasEF('aprobadas')
        && soloTareasEF('devoluciones')
        && (!('premioEdFisica' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.premioEdFisica == true);
    }

    // Sorteo del líder de Ed. Física (el id es la fecha): lo ve cualquiera con sesión y lo hace el docente.
    match /edfisica_sorteos/{fecha} {
      allow read: if signedIn();
      allow create, update: if esDocente()
        && fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['fecha', 'jefeId', 'manual', 'creado'])
        && request.resource.data.fecha == fecha
        && request.resource.data.jefeId in [1, 2, 3, 4, 5]
        && request.resource.data.manual is bool;
      allow delete: if esDocente();
    }

    // Movimientos de puntos: cada vez que cambia el contador de un equipo queda un registro (solo lo ve el docente).
    // La cuenta de Ed. Física solo puede registrar el +10 que le permiten las reglas de turnos.
    match /movimientos/{id} {
      allow read: if esDocente();
      allow create: if (esDocente() || (esDocenteEF() && request.resource.data.delta == 10))
        && request.resource.data.keys().hasOnly(['turnoId', 'delta', 'motivo', 'jornada', 'uid', 'creado'])
        && request.resource.data.turnoId in ['e1', 'e2', 'e3', 'e4', 'e5']
        && request.resource.data.delta is int
        && request.resource.data.motivo is string && request.resource.data.motivo.size() <= 120
        && request.resource.data.jornada is string
        && request.resource.data.uid == request.auth.uid;
      allow delete: if esSuperadmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
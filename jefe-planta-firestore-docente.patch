diff --git a/firestore.rules b/firestore.rules
new file mode 100644
index 0000000..ec6a34e
--- /dev/null
+++ b/firestore.rules
@@ -0,0 +1,59 @@
+rules_version = '2';
+service cloud.firestore {
+  match /databases/{database}/documents {
+
+    function signedIn() { return request.auth != null; }
+
+    // Docente: cuenta con email (no anónima) cuyo uid figura en /docentes (se crea a mano en la consola)
+    function esDocente() {
+      return signedIn()
+        && request.auth.token.firebase.sign_in_provider != 'anonymous'
+        && exists(/databases/$(database)/documents/docentes/$(request.auth.uid));
+    }
+
+    // Lo que puede escribir un alumno: solo tareas declaradas y su respuesta
+    function datosAlumnoValidos() {
+      let d = request.resource.data;
+      return (!('declaradas' in d)
+              || (d.declaradas is map
+                  && d.declaradas.keys().hasOnly(['fichaje', 'ventilacion', 'insumos', 'desafio'])
+                  && d.declaradas.values().hasOnly([true, false])))
+          && (!('respuesta' in d) || (d.respuesta is string && d.respuesta.size() <= 20));
+    }
+
+    match /docentes/{uid} {
+      allow read: if signedIn() && request.auth.uid == uid;
+      allow write: if false;
+    }
+
+    match /turnos/{turnoId} {
+      allow read: if signedIn();
+      allow write: if esDocente();   // los alumnos nunca escriben puntos
+    }
+
+    match /jornadas/{docId} {
+      allow read: if signedIn();
+
+      allow create: if signedIn()
+        && request.resource.data.keys().hasOnly(['fecha', 'jefeId', 'declaradas', 'respuesta'])
+        && request.resource.data.keys().hasAll(['fecha', 'jefeId'])
+        && request.resource.data.fecha is string
+        && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
+        && request.resource.data.jefeId is int
+        && request.resource.data.jefeId >= 1 && request.resource.data.jefeId <= 5
+        && docId == request.resource.data.fecha + '_' + string(request.resource.data.jefeId)
+        && datosAlumnoValidos();
+
+      allow update: if signedIn()
+        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['declaradas', 'respuesta'])
+        && datosAlumnoValidos()
+        // una vez aprobado el desafío, la respuesta ya no se puede cambiar
+        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['respuesta'])
+            || resource.data.get('desafioAprobado', false) == false);
+
+      allow create, update, delete: if esDocente();
+    }
+
+    match /{document=**} { allow read, write: if false; }
+  }
+}

# Copiá este archivo a .env y completá los datos de la app web de Firebase
# (Configuración del proyecto > Tus apps > SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA v3). Opcional en desarrollo; en producción conviene activarlo y poner "Enforce" en la consola de Firebase.
VITE_RECAPTCHA_SITE_KEY=
